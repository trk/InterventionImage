  "type": "pw-module",
  "keywords": [
    "processwire",
    "totoglu",
    "wire",
    "intervention",
    "image",
    "webp",
    "avif",
    "lqip",
    "responsive-images"
  ],
  "homepage": "https://github.com/trk/InterventionImage",
  "license": "MIT",
  "authors": [
    {
      "name": "Iskender TOTOGLU",
      "email": "iskender@totoglu.com",
      "homepage": "https://totoglu.com/"
    }
  ],
  "require": {
    "php": ">=8.3",
    "intervention/image": "^4.4"
  },
  "config": {
    "process-timeout": 0,
    "allow-plugins": {
      "hari/pw-module": true
    }
  },
  "minimum-stability": "dev"
}
